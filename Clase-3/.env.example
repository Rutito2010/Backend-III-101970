# ============================================================
# SHIPNOW API — VARIABLES DE ENTORNO
# ============================================================
#
# 📌 INSTRUCCIONES PARA EL ALUMNO:
#
# 1. Copiá este archivo y renombralo a ".env"
# 2. Completá los valores con tu configuración real
# 3. NUNCA subas el archivo .env a Git (ya está en .gitignore)
#
# Este archivo .env.example SÍ se sube al repositorio porque
# no contiene secretos reales. Sirve como documentación de
# qué variables necesita el proyecto para funcionar.
# ============================================================

# Puerto del servidor (default: 8080)
PORT=8080

# URI de conexión a MongoDB
# En desarrollo: mongodb://localhost:27017/shipnow-dev
# En producción: mongodb+srv://usuario:password@cluster.../shipnow
MONGODB_URI=mongodb://localhost:27017/shipnow

# Entorno de ejecución: development | test | production
NODE_ENV=development

# Secreto para firmar tokens JWT (agregar en producción)
JWT_SECRET=tu_clave_secreta_aqui

