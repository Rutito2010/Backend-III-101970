# copiar a .env y completar (el .env no se sube)

PORT=8080

# local: mongodb://localhost:27017/shipnow
MONGODB_URI=mongodb://localhost:27017/shipnow

# development | test | production
NODE_ENV=development

JWT_SECRET=tu_clave_secreta_aqui

# nivel mínimo de logs: debug | http | info | warning | error | fatal
LOG_LEVEL=debug
